# Calvin runtime configuration.
#
# Production layout (the Pi setup script puts both files here for you):
#   /etc/calvin/docker-compose.yml   (copied from docker/docker-compose.yml)
#   /etc/calvin/.env                 (copy of this file, edited)
# Then: `docker compose -f /etc/calvin/docker-compose.yml up -d`
#
# Local repo usage (dev or one-off prod test):
#   cp deploy/calvin.env.example docker/.env       # one-time
#   docker compose -f docker/docker-compose.yml up -d
#
# Compose auto-loads `.env` from the same directory as the compose
# file — no `env_file:` directive, no `--env-file` flag. Values are
# both substituted into the YAML and exported to the container.

# Where Calvin keeps mutable state on the host. Mounted into the
# container as /var/lib/calvin. The Pi systemd unit creates this.
CALVIN_DATA_DIR=/var/lib/calvin

# Backend port (host side). The container always listens on 8000;
# compose maps ${CALVIN_PORT}:8000.
CALVIN_PORT=8000

# Inside the container everything Calvin writes derives from its own
# CALVIN_DATA_DIR (/var/lib/calvin, the bind-mount target). These
# override single paths there; the values below are the defaults.
DATABASE_URL=sqlite:////var/lib/calvin/db/calvin.db
IMAGE_DIR=/var/lib/calvin/images
PLUGIN_DIR=/var/lib/calvin/plugins

# The address phones and new kiosks should use to reach this server, shown as a
# QR code in Settings and in the "Add kiosk" command. Inside Docker the server
# can only see its container IP, so set this to the host's LAN address.
# PUBLIC_URL=http://192.168.1.10:8000

# Behind a TLS-terminating reverse proxy, PUBLIC_URL should carry the https
# address. If you leave PUBLIC_URL unset instead, list the proxy's address here
# so the installer can honour X-Forwarded-Proto/X-Forwarded-Host. Comma-separated
# IPs/CIDRs, "*" for any; empty (the default) trusts no one.
# CALVIN_TRUSTED_PROXIES=172.17.0.1

# Comma-separated list of allowed CORS origins. Calvin serves the
# frontend itself, so usually only the dashboard URL needs to be here.
CORS_ORIGINS=http://localhost:8000

# Image tag to deploy. CI publishes:
#   :develop          every push to develop (the normal deploy tag)
#   :sha-<commit>     every published build, for pinning/rollback
#   :vX.Y.Z, :latest  on v* release tags (none published yet)
# Pin to a :sha-<commit> tag if you want reproducible deploys.
CALVIN_IMAGE_TAG=develop

# User/group that owns the files under CALVIN_DATA_DIR. 0/0 runs the
# server as root. On Unraid use 99/100 (nobody:users).
PUID=0
PGID=0

# Container timezone (IANA name), e.g. Europe/Stockholm.
TZ=Etc/UTC

# May Calvin act on the machine it runs on (reboot, systemd restarts,
# vcgencmd/xset/xrandr)? In a container this is always off: the container
# never controls the host (use the Docker/Unraid update flow instead), and
# CALVIN_HOST_CONTROL=1 does not change that. Outside Docker it defaults to
# on only for a native Pi/kiosk install; a dev backend on a desktop defaults
# to off. Set 1/0 to override. See docs/configuration/HOST_CONTROL.md.
# CALVIN_HOST_CONTROL=0

# Dev-only: absolute path to the Calvin source tree, bind-mounted at
# /app inside the dev containers. Defaults to `..` so running the dev
# compose directly from the repo's docker/ dir works without any
# config. The Pi dev setup writes the absolute repo path here so the
# compose can run from /etc/calvin/ instead.
# CALVIN_REPO_DIR=/home/calvin/calvin

# Stable per-kiosk identity. Sent to the server so it can distinguish kiosks
# and (later) serve per-kiosk config. Auto-generated by setup-kiosk.sh as
# <hostname>-<machine-id suffix>; override with a friendly name if you like.
# CALVIN_KIOSK_ID=kitchen
