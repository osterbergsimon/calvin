# Calvin runtime configuration.
#
# Copy this file to /etc/calvin/calvin.env (or wherever your deployment
# expects it) and edit the values for your environment. Both the prod
# and dev compose files read it via `env_file`, and the RPi systemd unit
# loads it before launching `docker compose up`.

# Where Calvin keeps mutable state on the host. Mounted into the container
# as /var/lib/calvin. The Pi systemd unit creates this directory.
CALVIN_DATA_DIR=/var/lib/calvin

# Backend port (host side). Inside the container, the app always listens
# on 8000. The compose file maps ${CALVIN_PORT}:8000.
CALVIN_PORT=8000

# Database URL. Defaults to a SQLite file under CALVIN_DATA_DIR.
DATABASE_URL=sqlite:////var/lib/calvin/db/calvin.db

# Locations the backend reads/writes inside the container. These are
# usually fine to leave as-is — they're inside /var/lib/calvin which is
# already a bind-mount target.
IMAGE_DIR=/var/lib/calvin/images
PLUGIN_DIR=/var/lib/calvin/plugins

# Comma-separated list of allowed CORS origins. The host serves the
# frontend itself, so usually only the dashboard URL needs to be here.
CORS_ORIGINS=http://localhost:8000

# Image tag to deploy. CI publishes :latest on develop builds and
# :stable on main. Pin to a specific SHA in production if you need
# reproducible deploys.
CALVIN_IMAGE_TAG=latest
