[Unit]
Description=Calvin X Server
# The only thing that starts X on tty1: takes tty1 over from getty (setup also
# disables getty@tty1 and removes the old autologin + startx-from-.bash_profile).
After=systemd-user-sessions.service network.target getty@tty1.service
Conflicts=getty@tty1.service
Before=calvin-kiosk.service calvin-kiosk-remote.service

[Service]
Type=simple
User=calvin
Group=calvin
# A logind session on tty1 lets Xorg run rootless (no Xwrapper/legacy setuid).
PAMName=login
UtmpIdentifier=tty1
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/bin/bash -c 'export DISPLAY=:0 && export XAUTHORITY=/home/calvin/.Xauthority && /usr/bin/startx -- :0 -nolisten tcp vt1'
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
