# Using Python 3.12 with UV copied from official distroless image
FROM python:3.12-slim

# Copy UV from official distroless image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update && apt-get install -y \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --extra dev

# Copy app code (will be mounted as volume in dev)
COPY backend/app ./app

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]

