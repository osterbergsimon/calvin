# Calvin dev-stack configuration (docker/docker-compose.dev.yml).
#
# `make install` copies this to docker/.env. Compose auto-loads `.env`
# from the compose file's directory. For a production server use
# deploy/calvin.env.example instead.
#
# Everything here is optional; the defaults are shown.

# Host directory holding the dev stack's database, images and plugins,
# mounted at /var/lib/calvin inside the backend container. Relative to
# docker/, so each checkout keeps its own. Leave it unset for dev: never
# point it at /var/lib/calvin, which belongs to a real install.
# CALVIN_DATA_DIR=./.calvin-dev-data

# Host ports. Change them to run a second checkout or worktree next to
# this one (`make dev` already gives each checkout its own compose project).
# CALVIN_PORT=8000
# CALVIN_FRONTEND_PORT=5173

# The address phones and new kiosks should use to reach this server, shown
# as a QR code in Settings. Inside Docker the server only sees its container
# IP, so set this to your machine's LAN address if you test with a phone.
# PUBLIC_URL=http://192.0.2.10:8000
